# ── Copy this to .env and fill in your values ────────────────────
# NEVER commit .env to source control

# ── Database ─────────────────────────────────────────────────────
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=sentinel

# ── Application ──────────────────────────────────────────────────
SECRET_KEY=changeme_32_char_random_string_here
ENVIRONMENT=development

# ── Frontend ─────────────────────────────────────────────────────
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws

# ── Keycloak ─────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_admin_password
KEYCLOAK_REALM=sentinel
KEYCLOAK_CLIENT_ID=sentinel-api

# ── Grafana ──────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=changeme_grafana_password

# ── Collector: ADS-B (OpenSky) ───────────────────────────────────
# Register free at: https://opensky-network.org/index.php?option=com_users&view=registration
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
ADSB_POLL_INTERVAL=10

# ── Collector: AIS (AISHub) ──────────────────────────────────────
# Register at: https://www.aishub.net/join-us
AISHUB_USERNAME=
AISHUB_PASSWORD=
AIS_POLL_INTERVAL=30

# ── Collector: Space (Space-Track) ───────────────────────────────
# Register free at: https://www.space-track.org/auth/createAccount
SPACETRACK_USER=
SPACETRACK_PASS=
TLE_REFRESH_INTERVAL=7200

# ── Collector: GPS Jam ───────────────────────────────────────────
GPSJAM_POLL_INTERVAL=3600

# ── Collector: Infrastructure ────────────────────────────────────
INFRA_POLL_INTERVAL=300
