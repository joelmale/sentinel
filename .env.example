# Sentinel minimal local configuration
#
# This file is intentionally small.
# Most runtime knobs already have defaults in code or docker-compose.
# Copy to `.env` only if you want to override the local-development defaults.
#
# For the full override surface, see `.env.advanced.example`.
# NEVER commit `.env` to source control.

# ── Core local secrets ────────────────────────────────────────────
# These now have development-safe docker-compose fallbacks, but you should
# still override them in any shared or production-like environment.
POSTGRES_PASSWORD=sentinel
SECRET_KEY=dev_secret_change_in_production

# ── Common local overrides ────────────────────────────────────────
ENVIRONMENT=development
POSTGRES_USER=sentinel
POSTGRES_DB=sentinel
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws

# ── Optional profiles ─────────────────────────────────────────────
# Only needed if you enable `--profile auth` or `--profile monitoring`.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=sentinel
KEYCLOAK_CLIENT_ID=sentinel-api
GRAFANA_ADMIN_PASSWORD=admin

# ── Optional external API credentials ────────────────────────────
# Leave blank to disable or fall back where supported.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
ADSBEXCHANGE_API_KEY=
ADSBEXCHANGE_RAPID_KEY=
AISSTREAM_API_KEY=
GFW_API_TOKEN=
SPACETRACK_USER=
SPACETRACK_PASS=
N2YO_API_KEY=
POWEROUTAGE_API_KEY=
CLOUDFLARE_RADAR_API_TOKEN=
EIA_API_KEY=
ACLED_USERNAME=
ACLED_PASSWORD=
MARINETRAFFIC_COOKIE_HEADER=
