{
  "id": "sentinel",
  "realm": "sentinel",
  "displayName": "SENTINEL",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "clients": [
    {
      "clientId": "sentinel-api",
      "name": "SENTINEL API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "webOrigins": [
        "http://localhost",
        "http://127.0.0.1"
      ],
      "defaultClientScopes": [
        "web-origins",
        "role_list",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "SENTINEL administrators"
      },
      {
        "name": "analyst",
        "description": "SENTINEL analysts"
      }
    ]
  }
}
