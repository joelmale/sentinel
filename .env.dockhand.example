# Sentinel Dockhand / Nginx Proxy Manager deployment template
#
# Keep this file small. Dockhand should only carry deployment values, active
# credentials, and optional profile toggles.
#
# Copy the keys you actually need into Dockhand's stack env UI or a
# server-side `.env.dockhand` file. Do not commit real secrets.

# ── Core deployment ───────────────────────────────────────────────
COMPOSE_PROJECT_NAME=sentinel
INTERNAL_DOCKER_NETWORK=sentinel-net
EXTERNAL_PROXY_NETWORK=homelab-net
SENTINEL_IMAGE_TAG=main
ENVIRONMENT=production
VITE_API_BASE_URL=/api
VITE_WS_URL=/ws

# Required secrets
POSTGRES_PASSWORD=replace_with_a_real_db_password
SECRET_KEY=replace_with_a_long_random_secret

# Optional profiles: auth, monitoring, historical, disruptions
COMPOSE_PROFILES=

# ── Core live collectors ──────────────────────────────────────────
# Leave blank to disable or use collector fallbacks where supported.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
ADSBEXCHANGE_API_KEY=
ADSBEXCHANGE_RAPID_KEY=
AISSTREAM_API_KEY=
GFW_API_TOKEN=
SPACETRACK_USER=
SPACETRACK_PASS=
N2YO_API_KEY=

# ── Optional profile secrets ──────────────────────────────────────
# Only needed if the matching profile or feature is enabled.
KEYCLOAK_ADMIN_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
POWEROUTAGE_API_KEY=
CLOUDFLARE_RADAR_API_TOKEN=
EIA_API_KEY=
ACLED_USERNAME=
ACLED_PASSWORD=

# ── Optional deployment overrides ─────────────────────────────────
CADDY_IMAGE=caddy:2-alpine
TIMESCALE_IMAGE=timescale/timescaledb-ha:pg16-ts2.24
REDIS_IMAGE=redis:7-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:24.0
GRAFANA_IMAGE=grafana/grafana-oss:latest
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
SCRAPE_SECRETS_DIR=./docker/secrets

# Dockhand parser warning:
# Do not place MARINETRAFFIC_COOKIE_HEADER, MARINETRAFFIC_SEC_CH_UA,
# ADSBX_BINCRAFT_COOKIES, or BINCRAFT_SEC_CH_UA in this env file.
# Use the *_FILE variables from `.env.dockhand.advanced.example` instead.
